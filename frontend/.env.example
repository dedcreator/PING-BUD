# Sentiro Frontend Production & Development Configuration
# ====================================================================
#
# Production Public API URL (Django Backend Endpoint)
# When deploying to Pxxl.app, Render, or Vercel, set this to your backend domain:
# e.g., NEXT_PUBLIC_API_URL=https://api.sentiro.xyz
# or    NEXT_PUBLIC_API_URL=https://sentiro-api.pxxl.pro
#
# Note: If omitted, the frontend automatically auto-detects:
# - localhost:3000 -> http://127.0.0.1:8000
# - sentiro.xyz -> https://api.sentiro.xyz
# - sentiro-web.pxxl.pro -> https://sentiro-api.pxxl.pro
#
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Google OAuth 2.0 Web Client ID (from console.cloud.google.com)
# When set, enables the official Google One-Tap & Sign-In button popup
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
