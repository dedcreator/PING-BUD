# ==============================================================================
# Sentiro (sentiro.xyz) - Production & Local Environment Configuration
# ==============================================================================

# Core Django Security


DEBUG=False
ALLOWED_HOSTS=sentiro.xyz,*.sentiro.xyz,localhost,127.0.0.1

# Domain & CORS
CSRF_TRUSTED_ORIGINS=https://sentiro.xyz,https://status.sentiro.xyz,https://api.sentiro.xyz

# Resend Email Delivery Infrastructure (resend.com)
# REST API email infrastructure for password resets, outage alerts, and incident summaries
RESEND_API_KEY=re_your_api_key_from_resend_com
RESEND_FROM_EMAIL=Sentiro Alerts <alerts@sentiro.xyz>

# Feedback & Issue Reporting Destination (Sent via Render / Resend)
FEEDBACK_RECEIVE_EMAIL=founder@yourcompany.com

# Bachs Payment Infrastructure (docs.bachs.io)
# Instant NGN bank transfer checkout & subscription billing
BACHS_API_KEY=sk_live_your_bachs_api_key
BACHS_WEBHOOK_SECRET=whsec_your_bachs_webhook_secret

# Telegram Bot Incident Dispatch (100% Free Carrier-grade Alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Multi-Region Edge Consensus Probing
CONSENSUS_NODES=Lagos,Frankfurt,Virginia,Singapore
CONSENSUS_QUORUM_THRESHOLD=0.75

# Google OAuth 2.0 Web Client ID (from console.cloud.google.com)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# SQLite WAL mode or PostgreSQL URL
# DATABASE_URL=postgres://user:pass@host:5432/sentiro
